# Copiez ce fichier vers .env (ou lancez : php database/install.php qui le génère).
# Ne versionnez JAMAIS le fichier .env : il contient les secrets.

APP_NAME=GestionCabinet
APP_URL=http://localhost:8080
APP_DEBUG=false
APP_TIMEZONE=Africa/Tunis
# Clé de chiffrement 32 octets (base64). Générée par install.php.
APP_KEY=

# ---- Base de données : Supabase (PostgreSQL) ----
# Dashboard Supabase > Connect > "Session pooler" : copiez l'hôte (aws-0-<région>.pooler.supabase.com)
# et la référence du projet (la partie après "postgres." dans le nom d'utilisateur).
# Port 5432 = pooler en mode session (requis : requêtes préparées natives).
DB_HOST=VOTRE-HOTE.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_PROJECT_REF=
# Schéma privé de l'application (non exposé par l'API REST de Supabase)
DB_SCHEMA=cabinet
# TLS : "require" chiffre ; "verify-full" + DB_SSLROOTCERT (certificat téléchargé depuis
# Dashboard > Database > SSL) vérifie aussi l'identité du serveur.
DB_SSLMODE=require
DB_SSLROOTCERT=
# Connexion persistante côté site web (évite 1 à 2,5 s de connexion à chaque page)
DB_PERSISTENT=true

# Rôle de l'application (créé par install.php, droits SELECT/INSERT/UPDATE/DELETE uniquement).
# DB_PASS est généré aléatoirement par install.php.
DB_USER=cabinet_app
DB_PASS=

# Compte administrateur Supabase : installation + sauvegardes uniquement, jamais utilisé par le site.
# DB_ADMIN_PASS = le mot de passe de la base choisi à la création du projet Supabase.
DB_ADMIN_USER=postgres
DB_ADMIN_PASS=

# Migration unique depuis l'ancienne base MySQL (database/migrate_from_mysql.php)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gestion_cabinet
MYSQL_USER=root
MYSQL_PASS=

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10

# Sécurité
MFA_REQUIRED_FOR_ADMIN=true
# Création libre de nouveaux cabinets via /register. Laisser false pour un cabinet unique :
# sinon n'importe qui peut créer un cabinet dans votre base. (true pour le mode SaaS et tests/functional_test.php)
ALLOW_CLINIC_REGISTRATION=false
MAX_BODY_BYTES=1048576

# Surveillance : e-mail qui reçoit les alertes (nécessite un serveur SMTP configuré dans php.ini)
ALERT_EMAIL=

# Sauvegardes
BACKUP_KEEP_DAYS=14
